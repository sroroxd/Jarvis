<?xml version="1.0" encoding="utf-8"?>
<!-- Einstellungen, gruppiert in Karten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationContentDescription="Zurück"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="Einstellungen"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- ===================================================== Gehirn -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gehirn (KI)" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/keyLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="API-Schlüssel"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/keyField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/modelLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Modell (leer = automatisch)"
                        app:helperText="Leer = Claude Sonnet 5.5 (schnell, ohne Nachdenken). Sparen: claude-haiku-5-5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/modelField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text|textNoSuggestions"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/testKey"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Schlüssel testen" />

                    <TextView
                        android:id="@+id/keyResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Sprachsteuerung -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sprachsteuerung" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWake"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Freihändig mit „Hey Jarvis“" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sag „Hey Jarvis“, warte den kurzen Ton ab und sprich los. Die Erkennung läuft offline auf dem Handy und pausiert bei ausgeschaltetem Bildschirm. Das Mikrofon-Symbol oben in der Statusleiste zeigt, dass Jarvis lauscht." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Jarvis.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Empfindlichkeit" />

                        <TextView
                            android:id="@+id/sensitivityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="1"
                        android:valueTo="10" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Höher = reagiert leichter, löst aber auch öfter versehentlich aus. Standard: 5." />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchEarcon"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Signalton, wenn Jarvis zuhört" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Jarvis.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sprechpause bis zum Absenden" />

                        <TextView
                            android:id="@+id/pauseValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderPause"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.1"
                        android:valueFrom="0.5"
                        android:valueTo="3.5" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="So lange wartet Jarvis nach deinem letzten Wort, bevor er antwortet. Länger = mehr Zeit zum Nachdenken." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Stimme -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stimme" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Mit ElevenLabs-Schlüssel spricht Jarvis mit der Premium-Stimme „Daniel“. Sonst offline über SherpaTTS: Thorsten → Miro → Alan. Deine eigene Auswahl hat immer Vorrang." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/engineLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Sprachausgabe (Handy)">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/engineDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/voiceLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Stimme">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/voiceDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Jarvis.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tempo" />

                        <TextView
                            android:id="@+id/rateValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.05"
                        android:valueFrom="0.5"
                        android:valueTo="1.5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Jarvis.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tonhöhe" />

                        <TextView
                            android:id="@+id/pitchValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderPitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="0.05"
                        android:valueFrom="0.5"
                        android:valueTo="1.5" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp" />

                    <TextView
                        style="@style/Jarvis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Premium-Stimme (ElevenLabs, optional)" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deutlich natürlicher, am nächsten am Film-Jarvis. Schlüssel von elevenlabs.io (kostenlos ca. 10 Minuten pro Monat). Leer lassen = Handy-Stimme." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/elevenKeyLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="ElevenLabs-Schlüssel (leer = aus)"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/elevenKeyField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/elevenVoiceLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Stimmen-ID (leer = Daniel)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/elevenVoiceField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text|textNoSuggestions"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/previewVoice"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Probe hören" />

                    <TextView
                        android:id="@+id/voiceResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Anzeige -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anzeige" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchFloatingJ"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Schwebendes J" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aus = nichts schwebt über anderen Apps. An: antippen = sprechen, lange drücken = neues Gespräch, ziehen = verschieben. Im Spielmodus immer ausgeblendet." />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSubtitles"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Untertitel am Bildschirmrand" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kleine halbtransparente Leiste mit Jarvis’ Antwort. Nicht anklickbar – Fingertipps gehen durch sie hindurch – und nach wenigen Sekunden wieder weg." />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSubtitlesGame"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Untertitel auch im Spielmodus" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Standard: aus – im Spiel antwortet Jarvis nur per Stimme. An: schmale Leiste, höchstens zwei Zeilen." />

                    <TextView
                        style="@style/Jarvis.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Position der Untertitel" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/positionGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/positionTop"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Oben" />

                        <Button
                            android:id="@+id/positionBottom"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Unten" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <LinearLayout
                        android:id="@+id/overlayWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dafür braucht Jarvis die Berechtigung „Über anderen Apps anzeigen“."
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorError" />

                        <Button
                            android:id="@+id/grantOverlay"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Erlauben" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Spielmodus -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spielmodus (TFT)" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchGame"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Spielmodus" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nichts verdeckt das Spielbild, Jarvis antwortet nur per Stimme und denkt als TFT-Coach mit (Claude Sonnet 5.5). Umschalten auch per Sprache: „Spielmodus an“ oder „Spielmodus aus“." />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Aktuelle Meta: Im Spielmodus recherchiert Jarvis einmal am Tag im Internet die aktuellen Comps, Augments und Patch-Änderungen (Claude-Websuche, ca. 3–5 Cent pro Tag)." />

                    <TextView
                        android:id="@+id/metaInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary" />

                    <Button
                        android:id="@+id/metaUpdate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Meta jetzt aktualisieren" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Hinweis: Live-Tipps während einer Partie verstoßen gegen Riots Regeln – Nutzung auf eigenes Risiko." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Gedächtnis -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gedächtnis" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Was Jarvis sich dauerhaft merkt. Sag „Merk dir …“ oder „Vergiss …“ – oder bearbeite es hier direkt." />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Gemerkte Fakten">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/memoryField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Sicherung -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sicherung" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Speichert Gedächtnis und Einstellungen in eine Datei auf deinem Handy (z. B. „Downloads“). Sie aktualisiert sich nach jeder Änderung und übersteht auch eine Deinstallation." />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBackupKeys"
                        style="@style/Jarvis.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="API-Schlüssel mitsichern" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bequem nach einer Neuinstallation – aber dann steht der Schlüssel im Klartext in der Datei. Gib sie in dem Fall an niemanden weiter." />

                    <TextView
                        android:id="@+id/backupInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/backupCreate"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Einrichten" />

                        <Button
                            android:id="@+id/backupOpen"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Wiederherstellen" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== Hilfe -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Jarvis.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Jarvis.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="So nutzt du Jarvis" />

                    <TextView
                        style="@style/Jarvis.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="• „Hey Jarvis“ sagen – oder auf dem Startbildschirm den Kern antippen, in der Benachrichtigung auf „Sprechen“ tippen oder die Seitentaste nutzen.\n• Pausen beim Sprechen sind erlaubt. Sofort abschicken: nochmal antippen.\n• Während Jarvis spricht: „Hey Jarvis“ oder Antippen unterbricht.\n• Lange drücken auf den Kern = neues Gespräch.\n• „Merk dir …“ speichert dauerhaft, „Vergiss …“ löscht wieder.\n• Seitentaste: Einstellungen → Erweiterte Funktionen → Seitentaste → Zweimal drücken → App öffnen → „Jarvis sprechen“.\n• Bei der Bildschirmfreigabe „Gesamter Bildschirm“ wählen." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
