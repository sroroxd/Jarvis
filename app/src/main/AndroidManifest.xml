<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Nur zu fragen, ob das Netz Mobilfunk ist (Warnung vor dem Modell-Download); wird ohne Nachfrage erteilt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Selbst-Update: neue geprüfte Version direkt einspielen, ohne Datei im Download-Ordner -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Echo- und Rauschunterdrückung fürs Dazwischenreden; normale Berechtigung, ohne Nachfrage. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Gesprächsmodus: MODE_IN_COMMUNICATION setzen, damit die Echo-Unterdrückung greift -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Systemdialog „Akku-Optimierung ignorieren?“ (Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS), Schutzstufe normal.
         Samsung beendet Hintergrund-Apps sonst gern – auch mitten in einer TFT-Partie. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Spielerkennung: sehen, ob TFT vorne ist. Art erteilt die Freigabe einmalig in den Android-Einstellungen. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Kalender: Termine vorlesen und eintragen -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_jarvis"
        android:label="@string/app_name"
        android:theme="@style/Theme.Jarvis"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Einstellungen"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LocalAssistantActivity"
            android:exported="false"
            android:label="Jarvis Lokal"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LocalLauncher"
            android:targetActivity=".LocalAssistantActivity"
            android:exported="true"
            android:label="Jarvis Lokal"
            android:icon="@drawable/ic_jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Zweites Symbol: startet sofort das Zuhören (z. B. für die Seitentaste). -->
        <activity
            android:name=".ListenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/listen_name"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <receiver android:name=".ReadyReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service android:name=".JarvisTileService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_jarvis"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".JarvisService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

    </application>
</manifest>
